[sub_resource type="Resource" id="Resource_ou7lp"]
script = ExtResource("4_qw1p8")
speaker = "Odd Todd"
position = "right"
text = "They're not for eating. You bring them to the Juicing Machine, each floor has one. It's quite simple, once you bring an item lended from a person you defeated, you juice it for the person's cards, though you can only get ONE card per reward, so do not expect to get every card in the deck."
sheet_path = SubResource("AtlasTexture_mavth")
grid_columns = 1
grid_rows = 1
frame_x = 0
frame_y = 0
metadata/_custom_type_script = "uid://bdv8hwcesqfca"

